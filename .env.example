# Copy to server/.env. These values are safe defaults for local development.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ms-vault-manager
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=5242880

# Leave false for local development. Set true before any shared or production use.
AUTH_REQUIRED=false

# Required to bind a preview to the exact uploaded file. Change this outside local dev.
PREVIEW_SECRET=dev-only-preview-secret-change-me

# Optional. When set, workbook import over HTTP requires header x-admin-token.
ADMIN_TOKEN=
